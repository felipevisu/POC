<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN" "http://struts.apache.org/dtds/struts-config_1_3.dtd">
<struts-config>
  <form-beans>
    <form-bean name="clienteForm" type="com.acme.web.ClienteForm"/>
  </form-beans>
  <global-forwards>
    <forward name="erro" path="/WEB-INF/jsp/erro.jsp"/>
  </global-forwards>
  <action-mappings>
    <action path="/cliente/detalhe" type="com.acme.web.DetalheClienteAction" name="clienteForm" scope="request">
      <forward name="sucesso" path="cliente.detalhe"/>
    </action>
  </action-mappings>
</struts-config>
